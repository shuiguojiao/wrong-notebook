#!/usr/bin/env bash
# 每个公开引用都要检查文件路径历史和公开基线后的全部可达对象。
set -euo pipefail
remote_name=$1
remote_url=$2
if [[ "$remote_name" != github && "$remote_url" != *github.com* ]]; then
    exit 0
fi
repo=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" == "$zero" ]] && continue
    python3 "$repo/scripts/check-public-history.py" "$local_oid"
    # 更新日志过期只提醒，不阻止推送
    if [[ "$remote_ref" == refs/heads/main ]] && ! python3 "$repo/scripts/changelog.py" --check --ref "$local_oid" 2>/dev/null; then
        echo "提醒：CHANGELOG.md 未包含本次推送的全部改动，可运行 python3 scripts/changelog.py 后提交。" >&2
    fi
done
